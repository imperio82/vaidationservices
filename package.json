{
  "name": "validation-service",
  "version": "1.0.0",
  "description": "Servicio de validaciones: registra o verifica personas por cédula (NestJS + MongoDB + DynamoDB Local)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
